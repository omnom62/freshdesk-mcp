# Freshdesk subdomain only — e.g. "mycompany" not "mycompany.freshdesk.com"
FRESHDESK_DOMAIN=mycompany

# Freshdesk API key — Profile → Profile Settings → API Key
FRESHDESK_API_KEY=your-api-key

# Bearer token for MCP client auth — generate any random secret
# e.g. openssl rand -base64 32
MCP_TOKEN=your-random-secret

# GCP project for Vision OCR — optional, leave empty to disable OCR
GCP_VISION_PROJECT=
